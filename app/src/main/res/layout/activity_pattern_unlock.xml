<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#99000000">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:background="@android:color/white">

        <TextView
            android:id="@+id/tvPatternTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parent Security Unlock"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/tvPatternMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Draw secret pattern to unlock screen"
            android:textSize="12sp"
            android:textColor="#64748B" />

        <com.touchlock.videocall.PatternLockView
            android:id="@+id/patternLockView"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnEmergencyPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Use Emergency PIN"
            android:textSize="12sp"
            android:textColor="#2563EB"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>
</LinearLayout>
