<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8FAFC">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TouchLock for Video Calls"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0F172A" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Prevents accidental hangs, mutes, and touches when passing phone to kids during calls."
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="#64748B" />

    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Grant Overlay Permission"
        android:backgroundTint="#0F172A"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnStartService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Enable Touch Lock"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="💡 Tip: Pull down your Quick Settings to use the TouchLock tile anytime!"
        android:textSize="12sp"
        android:textColor="#64748B" />
</LinearLayout>
